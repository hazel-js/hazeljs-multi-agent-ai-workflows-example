{
  "name": "hazeljs-multi-agent-ai-workflows-example",
  "version": "1.0.0",
  "description": "Complete examples of multi-agent orchestration patterns using HazelJS",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "example:delegate": "ts-node src/examples/01-delegate-pattern.ts",
    "example:graph": "ts-node src/examples/02-graph-pattern.ts",
    "example:supervisor": "ts-node src/examples/03-supervisor-pattern.ts",
    "example:complete": "ts-node src/examples/04-complete-pipeline.ts",
    "example:streaming": "ts-node src/examples/05-streaming-example.ts",
    "server:streaming": "ts-node src/server/main.ts",
    "test": "jest"
  },
  "keywords": [
    "hazeljs",
    "multi-agent",
    "ai",
    "orchestration",
    "agent-graph",
    "supervisor",
    "delegate"
  ],
  "author": "Muhammad Arslan <muhammad.arslan@hazeljs.ai>",
  "license": "Apache-2.0",
  "dependencies": {
    "@hazeljs/agent": "0.2.3",
    "@hazeljs/core": "0.2.3",
    "@hazeljs/rag": "0.2.3",
    "@hazeljs/ai": "0.2.3",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  }
}
